# Waste Management API Configuration
# Copy this file to .env and edit as needed
# Embedded mode reads WASTE_* variables to avoid collisions with the EMS backend.

# Model
MODEL_PATH=../best (4).pt
CONFIDENCE_THRESHOLD=0.4
REVIEW_THRESHOLD=0.25

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./waste.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/waste_db

# JWT Auth
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Storage
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo mode (auto-login, skip auth)
DEMO_MODE=true
