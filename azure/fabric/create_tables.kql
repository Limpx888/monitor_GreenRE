// ==============================================================================
// Microsoft Fabric Eventhouse / Azure Data Explorer (ADX) Schema Setup Script
// Database: GreenRE_Compliance_DB
// Table: telemetry_stream
// Description: Real-time time-series telemetry table mapped from Azure Event Hubs
// ==============================================================================

// 1. Create the Telemetry Stream Table with Trace Correlation
.create table telemetry_stream (
    timestamp: datetime,
    trace_id: string,
    building: string,
    zone: string,
    floor: string,
    energy_main_kw: real,
    water_flow_lpm: real,
    chiller_efficiency_kw_rt: real,
    ahu_damper_pos: real,
    ieq_co2_ppm: real,
    anomaly_flag: bool
)

// 2. Enable Sub-Second Streaming Ingestion Policy for Event Hubs
.alter table telemetry_stream policy streamingingestion enable

// 3. Create JSON Ingestion Mapping for Azure Event Hubs Payload
.create-or-alter table telemetry_stream ingestion json mapping 'telemetry_stream_json_mapping'
```
[
    {"column": "timestamp", "path": "$.timestamp", "datatype": "datetime"},
    {"column": "trace_id", "path": "$.trace_id", "datatype": "string"},
    {"column": "building", "path": "$.building", "datatype": "string"},
    {"column": "zone", "path": "$.zone", "datatype": "string"},
    {"column": "floor", "path": "$.floor", "datatype": "string"},
    {"column": "energy_main_kw", "path": "$.readings.energy_main_kw", "datatype": "real"},
    {"column": "water_flow_lpm", "path": "$.readings.water_flow_lpm", "datatype": "real"},
    {"column": "chiller_efficiency_kw_rt", "path": "$.readings.chiller_efficiency_kw_rt", "datatype": "real"},
    {"column": "ahu_damper_pos", "path": "$.readings.ahu_damper_position_pct", "datatype": "real"},
    {"column": "ieq_co2_ppm", "path": "$.readings.ieq_co2_ppm", "datatype": "real"},
    {"column": "anomaly_flag", "path": "$.anomaly_flag", "datatype": "bool"}
]
```

// 4. Verification & Diagnostic Query: GreenRE Night Drift & Water Anomaly
// Correlates with the exact trace_id generated by the Event Hubs ingestion client:
telemetry_stream
| where timestamp > ago(2h)
| where water_flow_lpm > 40.0 or ahu_damper_pos > 80.0
| summarize 
    max_water_flow = max(water_flow_lpm), 
    avg_energy_kw = avg(energy_main_kw), 
    max_damper = max(ahu_damper_pos) 
    by zone, floor, trace_id
| order by max_water_flow desc
